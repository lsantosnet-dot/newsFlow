# Chave de API do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Caminho local para o JSON da service account do Firebase (uso local apenas).
# No GitHub Actions, o conteúdo do JSON vem do secret FIRESTORE_SERVICE_ACCOUNT_JSON
# e é escrito em disco pelo workflow — não defina esta variável no Actions.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ID do projeto Firebase/Google Cloud (plano Spark).
FIRESTORE_PROJECT_ID=

# Filtros mínimos de ingestão (opcionais, têm defaults no código)
HN_MIN_SCORE=50
HN_MIN_COMMENTS=10
DEVTOO_TAGS=ai,machinelearning,rust,golang,architecture,softwareengineering,llm

# Janela de dedupe (dias)
DEDUPE_WINDOW_DAYS=7
