# Chave de API do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Caminho local para o JSON da service account do Firebase (uso local apenas).
# No GitHub Actions, o conteúdo do JSON vem do secret FIRESTORE_SERVICE_ACCOUNT_JSON
# e é escrito em disco pelo workflow — não defina esta variável no Actions.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ID do projeto Firebase/Google Cloud (plano Spark).
FIRESTORE_PROJECT_ID=

# Modelo do Gemini (opcional; o padrão está em curate.py).
# GEMINI_MODEL=gemini-3.1-flash-lite

# Intervalo entre chamadas ao Gemini, em segundos. O tier gratuito permite
# 15 req/min, então ~4s evita estourar o limite.
GEMINI_REQUEST_DELAY_SECONDS=4

# ---------------------------------------------------------------------------
# As fontes e os critérios de curadoria NÃO ficam mais aqui: vêm do perfil ativo
# na coleção `profiles` do Firestore, editável pelo app Flutter. As variáveis
# abaixo são apenas o fallback usado quando o perfil não define o próprio valor.
# ---------------------------------------------------------------------------

# Janela de dedupe (dias) — sobreposta por `dedupe_window_days` do perfil.
DEDUPE_WINDOW_DAYS=7
