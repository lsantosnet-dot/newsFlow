rules_version = '2';

// Regras de segurança para uso pessoal:
// - Leitura pública (o app não usa Firebase Auth; o feed não contém dados sensíveis).
// - O pipeline de curadoria grava e apaga via Admin SDK (service account), que ignora
//   estas regras — é assim que a rotina de limpeza de artigos lidos funciona.
// - O app cliente só pode alterar os campos `read`/`read_at` (marcar artigo como
//   lido/ouvido) e `favorite` (favoritar/desfavoritar).
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{articleId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'read_at', 'favorite']);
      allow create, delete: if false;
    }
  }
}
